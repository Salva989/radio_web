# Copy these values from Zeno.fm Broadcast Settings.
# Then copy this file to ../chrome-live-input/azuracast-live.env.

AZURACAST_HOST=stream.zeno.fm
AZURACAST_API_BASE=
AZURACAST_STATION_NAME="radio_web"
AZURACAST_STATION_SHORT_NAME=radio_web
AZURACAST_ICECAST_PORT=80
AZURACAST_MOUNT=/replace-with-your-mount
AZURACAST_STREAMER_USERNAME=source
AZURACAST_STREAMER_PASSWORD=replace-with-your-stream-key

# Public listener URL used by GitHub Pages.
PUBLIC_STREAM_URL=https://stream.zeno.fm/replace-with-your-public-stream

BUTT_BITRATE_KBPS=128
CHROME_LIVE_INPUT_PORT=3050
FFMPEG_PATH=ffmpeg

