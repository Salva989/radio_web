# Copy this file to azuracast-live.env and fill it with your local live input
# settings. This direct Icecast setup is the lightweight VPS path.

AZURACAST_HOST=stream.salvamagno.com
AZURACAST_API_BASE=
AZURACAST_STATION_NAME="radio_web"
AZURACAST_STATION_SHORT_NAME=radio_web
AZURACAST_ICECAST_PORT=8000
AZURACAST_MOUNT=/live.mp3
AZURACAST_SOURCE_METHOD=SOURCE

# Icecast source credentials.
AZURACAST_STREAMER_USERNAME=source
AZURACAST_STREAMER_PASSWORD=

# Local Windows audio routing.
WINDOWS_CHROME_OUTPUT_DEVICE="CABLE Input"
BUTT_AUDIO_INPUT_DEVICE="CABLE Output"
BUTT_CODEC=mp3
BUTT_BITRATE_KBPS=128

# Local browser relay settings.
CHROME_LIVE_INPUT_PORT=3050
FFMPEG_PATH=ffmpeg
