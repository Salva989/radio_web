# Copy this file to azuracast-live.env and fill it with your local live input
# settings. This file is only a note/template for BUTT or other encoders.

AZURACAST_HOST=localhost
AZURACAST_API_BASE=http://localhost/api
AZURACAST_STATION_NAME="Azura One"
AZURACAST_STATION_SHORT_NAME=azura_one
AZURACAST_ICECAST_PORT=8102
AZURACAST_MOUNT=/live
AZURACAST_SOURCE_METHOD=SOURCE

# Create these in AzuraCast under the station's Streamer/DJ settings.
AZURACAST_STREAMER_USERNAME=
AZURACAST_STREAMER_PASSWORD=

# Local Windows audio routing.
WINDOWS_CHROME_OUTPUT_DEVICE="CABLE Input"
BUTT_AUDIO_INPUT_DEVICE="CABLE Output"
BUTT_CODEC=mp3
BUTT_BITRATE_KBPS=192

# Local browser relay settings.
CHROME_LIVE_INPUT_PORT=3050
FFMPEG_PATH=ffmpeg
